{
    "appId": "com.ateffawzy.nawa",
    "appName": "Nawa",
    "webDir": "build",
    "backgroundColor": "#7668e8",
    "plugins": {
        "LocalNotifications": {
            "smallIcon": "ic_stat_nawa",
            "iconColor": "#7668e8"
        },
        "SplashScreen": {
            "launchShowDuration": 1200,
            "launchAutoHide": true,
            "backgroundColor": "#7668e8",
            "androidScaleType": "CENTER_CROP",
            "showSpinner": false
        },
        "StatusBar": {
            "style": "LIGHT",
            "backgroundColor": "#7668e8",
            "overlaysWebView": false
        }
    }
}
{
  "name": "nawa-tasks",
  "version": "5.1.0",
  "private": true,
  "description": "Nawa Arabic productivity app for web, Android, iOS and desktop.",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "vite build --mode web",
    "build:native": "vite build --mode native",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:ci": "vitest run",
    "mobile:add:android": "node scripts/native-setup.mjs android",
    "mobile:add:ios": "node scripts/native-setup.mjs ios",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:android": "npm run build:native && cap sync android && cap open android",
    "mobile:android:debug": "node scripts/build-android.mjs debug",
    "mobile:android:release": "node scripts/build-android.mjs release",
    "mobile:ios": "npm run build:native && cap sync ios && cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:appimage": "tauri build --bundles appimage",
    "desktop:icons": "tauri icon public/logo512.png",
    "verify:native": "node scripts/verify-native-setup.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/app": "^8.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

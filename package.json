{
  "name": "nawa",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Nawa (نَواة): an Arabic-first, offline-first task manager for web, Android, iOS and desktop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode web",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run verify:native && npm run build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:native": "tsc --noEmit && vite build --mode native",
    "start": "vite",
    "mobile:add:android": "node scripts/native-setup.mjs android",
    "mobile:add:ios": "node scripts/native-setup.mjs ios",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:android": "npm run build:native && cap sync android && cap open android",
    "mobile:android:debug": "node scripts/build-android.mjs debug",
    "mobile:android:release": "node scripts/build-android.mjs release",
    "mobile:ios": "npm run build:native && cap sync ios && cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:appimage": "tauri build --bundles appimage",
    "desktop:icons": "tauri icon public/logo512.png",
    "verify:native": "node scripts/verify-native-setup.mjs",
    "test:ci": "vitest run"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/alexandria": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
